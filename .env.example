# MongoDB
MONGO_URI=mongodb://localhost:27017/elysium-tours
TEST_MONGO_URI=mongodb://localhost:27017/elysium-tours-test

# ── MongoDB egress tuning (mixins/db.mixin.js) ───────────────────────────────
# Atlas is off-platform, so all DB traffic is billed bandwidth. Defaults below
# are already applied in code; override only if you need to.
#   MONGO_COMPRESSORS   wire compression. zlib needs no extra package.
#                       Install @mongodb-js/zstd first to use zstd.
#   MONGO_HEARTBEAT_MS  driver pings every replica-set node this often, even
#                       when idle. Driver default 10000 is the main idle cost.
#   MONGO_MAX_POOL      driver default is 100 — far more than needed.
#   MONGO_AUTO_INDEX    defaults to false in production (indexes belong in a
#                       migration). Set true for a one-off index build.
MONGO_COMPRESSORS=zlib
MONGO_ZLIB_LEVEL=6
MONGO_HEARTBEAT_MS=60000
MONGO_MAX_POOL=10
MONGO_MIN_POOL=0
# MONGO_AUTO_INDEX=false

# ── Caching (config/cache.config.js) ────────────────────────────────────────
# In-process Memory cacher on public catalogue reads only. Kill switch if
# stale data is ever suspected in production:
# DISABLE_CACHE=true

# Redis — used by Bull queues. Does NOT automatically enable Moleculer transporter.
REDIS_URL=redis://localhost:6379

# Multi-node Moleculer — set true ONLY when services run in separate processes
# (docker-compose workers). Leave unset/false on a single Render web service
# that runs `npm start` (all services in one process). Enabling MULTI_NODE with
# an external REDIS_URL causes continuous heartbeat/INFO egress with no traffic.
MULTI_NODE=false
# Optional overrides when MULTI_NODE=true (defaults: 30s / 90s)
# HEARTBEAT_INTERVAL=30
# HEARTBEAT_TIMEOUT=90

# Optional DNS override (comma-separated). Leave unset on Render.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# OTP
OTP_EXPIRY_MINUTES=10

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxx

# Email — Option A: Gmail App Password (dev / quick setup)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=your-email@yourcompany.com

# Email — Option B: Gmail OAuth2 (production recommended)
# When all three GOOGLE_* vars below are set, OAuth2 is used automatically.
# Get these from Google Cloud Console → APIs & Services → Credentials.
# Get GOOGLE_REFRESH_TOKEN via https://developers.google.com/oauthplayground
GOOGLE_OAUTH_USER=your-email@yourcompany.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# SendGrid (fallback if both SMTP and OAuth2 fail)
SENDGRID_API_KEY=SG.xxxxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Hubtel SMS (Ghana — primary SMS provider)
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SENDER_ID=ElysiumTours

# Twilio (WhatsApp + SMS fallback)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Sanity CMS
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your-api-token

# Google OAuth (shared between email OAuth2 and user Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_REFRESH_TOKEN=1//xxxxx

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://elysiumtour.com
LOG_LEVEL=info

# Observability (Moleculer tracing + metrics)
# Toggle on for terminal traces & metrics; tests force these to "false".
TRACING_ENABLED=false
# In production, set 0.0 <= TRACING_SAMPLE_RATE <= 1.0 (dev always traces everything)
TRACING_SAMPLE_RATE=0.1
METRICS_ENABLED=false
# Console reporter print interval in seconds
METRICS_INTERVAL=30
# Expose Prometheus /metrics endpoint (built-in HTTP server on its own port)
METRICS_PROMETHEUS=false
PROMETHEUS_PORT=3030

# FX / forex (USD-priced tours → GHS settlement via Paystack)
# Warn in logs when the most recent USD→GHS rate is older than N days
FOREX_RATE_MAX_AGE_DAYS=7
# Default commitment fee percent applied at booking creation (overridable per-package)
DEFAULT_COMMITMENT_FEE_PERCENT=15

# CORS — comma-separated origins (do not use * when CORS_CREDENTIALS=true)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
# For production, set to your frontend domains:
# CORS_ORIGIN=https://elysiumtour.com,https://admin.elysiumtour.com
# CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
# CORS_CREDENTIALS=true

# Commitment Fee
DEFAULT_COMMITMENT_FEE_PERCENT=15

# SLA
DEFAULT_SLA_HOURS=72

# Grafana Cloud — credentials for Alloy remote_write and DORA metric push
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-XX.grafana.net/api/prom/push
GRAFANA_CLOUD_USER=<your-grafana-cloud-instance-id>
GRAFANA_CLOUD_API_KEY=

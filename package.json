{
  "name": "elysium-tours-backend",
  "version": "1.0.0",
  "description": "Elysium Tours — MoleculerJS microservices backend for Ghana tour platform",
  "main": "moleculer.config.js",
  "scripts": {
    "dev": "moleculer-runner --repl --hot services/**/*.service.js",
    "start": "moleculer-runner services/**/*.service.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPattern=tests/unit --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:phase1": "node scripts/testScripts/test-phase1.js",
    "test:phase2": "node scripts/testScripts/test-phase2.js",
    "test:phase3": "node scripts/testScripts/test-phase3.js",
    "test:phase4": "node scripts/testScripts/test-phase4.js",
    "seed:roles": "node scripts/seedScripts/seed-roles.js",
    "seed:permissions": "node scripts/seedScripts/seed-permissions.js",
    "seed:destinations": "node scripts/seedScripts/seed-destinations.js",
    "seed:all": "npm run seed:roles && npm run seed:permissions && npm run seed:destinations",
    "lint": "eslint services/ mixins/ middlewares/ utils/ config/"
  },
  "keywords": [
    "moleculer",
    "microservices",
    "tourism",
    "ghana",
    "paystack"
  ],
  "author": "Emmanuel Amokuandoh",
  "license": "UNLICENSED",
  "dependencies": {
    "@sanity/client": "^7.20.0",
    "@sendgrid/mail": "^8.1.3",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.2",
    "cloudinary": "^2.1.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "moleculer": "^0.14.32",
    "moleculer-db": "^0.8.26",
    "moleculer-db-adapter-mongoose": "^0.11.0",
    "moleculer-web": "^0.10.7",
    "mongoose": "^8.2.0",
    "nats": "^2.24.0",
    "nodemailer": "^6.9.13",
    "slugify": "^1.6.6",
    "twilio": "^5.0.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
